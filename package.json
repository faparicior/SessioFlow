{
  "name": "sessioflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/shared/*",
    "packages/modules/*",
    "packages/config/*"
  ],
  "scripts": {
    "dev": "npx turbo dev",
    "build": "npx turbo build",
    "lint": "npx turbo lint",
    "typecheck": "npm run typecheck --workspace=apps/backend && npm run typecheck --workspace=apps/frontend",
    "test": "vitest run",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace=apps/frontend",
    "test:architecture": "vitest run tests/backend/unit/architecture/ddd-boundaries.test.ts",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:push": "npm run db:push --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "postinstall": "npm run postinstall --workspace=apps/backend"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.42.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nielspeter/ts-archunit": "^0.12.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint-config-xo-react": "^0.29.0",
    "jsdom": "^29.1.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "turbo": "^2.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "xo": "^2.0.2"
  }
}
