    {
      "pattern": "^bounded-context/"
    },
    {
      "pattern": "theeditorial\\.news"
    },
    {
      "pattern": "youngju\\.dev"
    },
    {
      "pattern": "flow-XX-name"
    },
    {
      "pattern": "BR-001-rule-name"
    },
    {
      "pattern": "INV-001-invariant-name"
    },
    {
      "pattern": "flow-01-name"
    },
    {
      "pattern": "inception/5-brainstorming"
    },
    {
      "pattern": "inception/6-user-journeys"
    },
    {
      "pattern": "inception/7-features-and-sequencing"
    },
    {
      "pattern": "inception/3-personas"
    },
    {
      "pattern": "path/to/flow"
    }
  ]
}