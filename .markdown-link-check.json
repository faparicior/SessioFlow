      "pattern": "^#"
    },
    {
      "pattern": "0XX-original-filename\\.md"
    },
    {
      "pattern": "^link$"
    },
    {
      "pattern": "%5B"
    },
    {
      "pattern": "entity-name"
    },
    {
      "pattern": "EntityName\\.md"
    },
    {
      "pattern": "VoName\\.md"
    },
    {
      "pattern": "value-object-name"
    },
    {
      "pattern": "US-101-example-flow"
    },
    {
      "pattern": "US-202-example-payment"
    },
    {
      "pattern": "flow-0*1?-?name"
    },
    {
      "pattern": "XXX-xxx-xxx"
    },
    {
      "pattern": "persona-[0-9]\\.md"
    },
    {
      "pattern": "persona-1\\.md"
    },
    {
      "pattern": "persona-2\\.md"
    },
    {
      "pattern": "journey-name\\.md"
    },
    {
      "pattern": "^path/to/"
