{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@sessioflow/shared-domain": ["./packages/shared/domain/src"],
      "@sessioflow/shared-domain/*": ["./packages/shared/domain/src/*"],
      "@sessioflow/shared-http": ["./packages/shared/http/src"],
      "@sessioflow/shared-http/*": ["./packages/shared/http/src/*"],
      "@sessioflow/bus": ["./packages/shared/bus/src"],
      "@sessioflow/bus/*": ["./packages/shared/bus/src/*"],
      "@sessioflow/conference": ["./packages/modules/conference/src"],
      "@sessioflow/conference/*": ["./packages/modules/conference/src/*"],
      "@backend/*": ["./apps/backend/src/*"],
      "@frontend/*": ["./apps/frontend/src/*"]
    }
  },
  "include": ["tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
